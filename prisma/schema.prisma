// Schema do PearChat. Multi-tenant por workspaceId.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  OFICIAL
  RAPIDA
}

enum ConnectionStatus {
  DESCONECTADO
  AGUARDANDO_QR
  CONECTANDO
  CONECTADO
  ERRO
}

// null = ninguem atendeu ainda
enum ConversationMode {
  IA
  HUMANO
}

enum MessageAuthor {
  CLIENTE
  USER
  IA
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

enum EventOrigin {
  IA
  GOOGLE
  MANUAL
}

enum TemplateCategory {
  MARKETING
  UTILIDADE
}

enum TemplateStatus {
  APROVADO
  EM_ANALISE
  REJEITADO
  // Meta oficial (migration 0014)
  PAUSADO
  DESATIVADO
}

enum Plan {
  ESSENCIAL
  PRO
  NEGOCIOS
}

// Conta/empresa do cliente: plano, assinatura e limites. Cada WhatsApp é um Workspace (espaço) dentro dela.
model Organization {
  id               String   @id @default(cuid())
  nome             String
  plano            Plan     @default(PRO)
  statusAssinatura String   @default("ativa")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Cobrança (migration 0017). billingStatus: trial|ativa|pendente|atrasada|cancelada|isenta. Só vale com BILLING_ENABLED=true.
  billingStatus       String    @default("isenta")
  trialAte            DateTime?
  planoPendente       Plan?
  planoAgendado       Plan?
  asaasCustomerId     String?   @unique
  asaasSubscriptionId String?   @unique
  proximaCobranca     DateTime?
  canceladaEm         DateTime?
  atrasadaDesde       DateTime?
  cpfCnpj             String?
  avisoTrialEm        DateTime?

  workspaces      Workspace[]
  users           User[]
  invites         Invite[]
  billingInvoices BillingInvoice[]
}

// Eventos do webhook do Asaas (idempotência pelo id do evento). O resumo não guarda dados pessoais.
model BillingEvent {
  id             String    @id @default(cuid())
  asaasEventId   String    @unique
  tipo           String
  organizationId String?
  resumo         Json?
  iniciadoEm     DateTime  @default(now())
  processadoEm   DateTime?
  createdAt      DateTime  @default(now())
}

// Cobranças da assinatura (espelho do Asaas). Sem dados de cartão.
model BillingInvoice {
  id             String    @id @default(cuid())
  asaasId        String    @unique
  organizationId String
  valor          Decimal   @db.Decimal(10, 2)
  status         String
  vencimento     DateTime?
  pagoEm         DateTime?
  invoiceUrl     String?
  assinaturaId   String?
  descricao      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, vencimento])
}

model Workspace {
  id                     String   @id @default(cuid())
  // Nulo só em linhas anteriores à migração 0008 ou criadas pelo app antigo: o código cria sob demanda.
  organizationId         String?
  ordem                  Int      @default(0)
  arquivadoEm            DateTime?
  nome                   String
  horarioAtendimento     String?
  // Logo do negócio deste WhatsApp: `/api/logo/<id opaco>` (arquivo em MEDIA_DIR/logos/<workspaceId>/), como User.fotoUrl.
  logoUrl                String?
  plano                  Plan     @default(PRO)
  statusAssinatura       String   @default("ativa")
  disparosAtivos         Boolean  @default(false)
  // Horário de silêncio dos disparos (fuso de São Paulo); a janela pode cruzar a meia-noite.
  disparosSilencioAtivo  Boolean  @default(true)
  disparosSilencioInicio Int      @default(21)
  disparosSilencioFim    Int      @default(8)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users              User[]
  whatsappSession    WhatsAppSession?
  contacts           Contact[]
  conversations      Conversation[]
  aiAgent            AiAgent?
  templates          Template[]
  campaigns          Campaign[]
  followUpRule       FollowUpRule?
  calendarConnection CalendarConnection?
  events             Event[]
  serviceTypes       ServiceType[]
  invoices           Invoice[]
  usageCounters      UsageCounter[]
  aiJobs             AiJob[]
  quickReplies       QuickReply[]

  // Link público de agendamento (Etapa 4): /a/<slug>. Desligado por padrão; o slug é gerado ao ativar.
  slug                    String?  @unique
  bookingAtivo            Boolean  @default(false)
  bookingAntecedenciaMin  Int      @default(120)
  bookingDiasAFrente      Int      @default(30)
  bookingMensagem         String?
  bookingAttempts         BookingAttempt[]
  members                 SpaceMember[]

  @@index([organizationId])
}

model User {
  id            String    @id @default(cuid())
  // workspaceId = espaço (WhatsApp) ATIVO do usuário.
  workspaceId   String
  organizationId String?
  nome          String
  email         String    @unique
  passwordHash  String?
  fotoUrl       String?
  notifs        String[]  @default([])
  papel         String    @default("owner")
  emailVerified DateTime? // compat Auth.js
  image         String? // compat Auth.js
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Segurança do login (migração 0011): 2FA por TOTP e versão de sessão (invalida JWTs antigos).
  totpSecret     String? // criptografado (AES-GCM, src/server/whatsapp/crypto.ts)
  totpEnabledAt  DateTime?
  totpLastStep   Int? // último passo de 30 s aceito (anti-reuso)
  sessionVersion Int       @default(0)
  // Equipe (migração 0015): papel = owner | admin | agent; desativadoEm = removido da equipe (não entra, sessões caem).
  desativadoEm   DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  spaceMemberships      SpaceMember[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  invitesSent           Invite[]
  accounts     Account[]
  sessions     Session[]
  recoveryCodes RecoveryCode[]

  @@index([workspaceId])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model WhatsAppSession {
  id                String           @id @default(cuid())
  workspaceId       String           @unique
  provider          Provider?
  numero            String?
  status            ConnectionStatus @default(DESCONECTADO)
  sessionData       String? // criptografado
  metaPhoneNumberId String?          @unique
  metaWabaId        String?
  evolutionInstance String?
  lastQr            String?
  lastQrAt          DateTime?
  // Importação do histórico (conexão rápida): quando conectou e o andamento da importação.
  connectedAt       DateTime?
  historyStatus     String           @default("nao_iniciada") // nao_iniciada | importando | concluida | erro
  historyStartedAt  DateTime?
  historyImportedAt DateTime?
  historyStats      Json?
  historyPasses     Int              @default(0) // passagens agendadas já feitas (1, 3, 10 e 30 min)
  // Meta oficial (migration 0014)
  metaBusinessId    String?
  metaVerifiedName  String?
  metaQuality       String? // GREEN | YELLOW | RED | UNKNOWN
  metaCoexistence   Boolean          @default(false)
  metaLastError     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([metaWabaId])
  @@index([evolutionInstance])
}

model Contact {
  id           String    @id @default(cuid())
  workspaceId  String
  waUserId     String? // BSUID do WhatsApp
  telefone     String? // E.164
  nome         String
  email        String?
  tags         String[]
  endereco     String?
  aniversario  DateTime?
  notas        String?
  optOut       Boolean   @default(false)
  // Foto do WhatsApp (migration 0019): caminho interno /api/contact-photo/<id> e quando foi verificada pela última vez.
  photoUrl       String?
  photoCheckedAt DateTime?
  pedidos      Int       @default(0)
  totalGasto   Decimal   @default(0)
  clienteDesde DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation?
  events       Event[]
  recipients   CampaignRecipient[]

  @@unique([workspaceId, waUserId])
  @@unique([workspaceId, telefone])
  @@index([workspaceId])
}

model Conversation {
  id            String            @id @default(cuid())
  workspaceId   String
  contactId     String            @unique
  mode          ConversationMode?
  unread        Int               @default(0)
  lastMessageAt DateTime?
  typing        Boolean           @default(false)
  // Responsável pela conversa (migração 0015). Nulo = sem responsável.
  assigneeId    String?
  assignedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  // Horários que a IA ofereceu pela ferramenta de agenda: [{ s: serviceTypeId, i: inicio ISO, t: ofertado em ms }]. Migration 0012.
  ofertasIa     Json?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  Message[]
  jobs      FollowUpJob[]
  aiJobs    AiJob[]

  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, assigneeId])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  author            MessageAuthor
  body              String
  mediaUrl          String?
  status            MessageStatus    @default(PENDENTE)
  providerMessageId String?
  // Veio da importação do histórico: o motor (IA, follow-up) não age sobre estas mensagens.
  imported          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  // Mídia (migration 0009): image | audio | video | document | sticker. Arquivo no MediaStore (`mediaKey`).
  mediaType         String?
  mediaMime         String?
  mediaSize         Int?
  mediaName         String?
  mediaKey          String?
  mediaDurationSec  Int?
  // Transcrição de áudio recebido: pendente | feito | erro | indisponivel.
  transcript        String?
  transcriptStatus  String?
  // Download/gravação do arquivo: pendente | ok | erro | expirada.
  mediaStatus       String?
  // Id da mídia na Graph API da Meta (migration 0014): usado para baixar o arquivo de mensagens recebidas.
  providerMediaId   String?
  // Motivo curto da falha de envio (migration 0014), sem dados do cliente.
  failReason        String?
  // Quem enviou a mensagem pelo app (migração 0015). Sem relação: o histórico sobrevive à saída da pessoa.
  senderUserId      String?
  // Robustez do envio (migration 0021). sendKey: chave de idempotência de um envio automático (ex.: "ai:<jobId>"):
  // o mesmo job nunca grava/envia duas mensagens. uncertainSince: o provedor pode ter aceitado o envio, mas não
  // confirmou (timeout/queda): fica PENDENTE e só é reenviado depois da reconciliação (engine/delivery.ts).
  sendKey           String?
  uncertainSince    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, providerMessageId])
  @@unique([conversationId, sendKey])
  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@index([status, createdAt])
}

model AiAgent {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  enabled      Boolean  @default(false)
  nome         String   @default("Luna")
  tom          String   @default("amigavel")
  prompt       String   @default("")
  horario      String   @default("sempre")
  handoffRules String[]
  canSchedule  Boolean  @default(false)
  idioma       String   @default("auto") // idioma das respostas: auto | pt | en | es
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledge KnowledgeItem[]
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  agentId   String
  pergunta  String
  resposta  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model Template {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  category    TemplateCategory
  status      TemplateStatus
  body        String
  // Meta oficial (migration 0014): metaId vazio = modelo "Só no PearChat" (não existe na Meta).
  metaId          String?
  language        String    @default("pt_BR")
  rejectionReason String?
  components      Json?
  syncedAt        DateTime?
  exampleValues   String[]  @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Campaign {
  id             String    @id @default(cuid())
  workspaceId    String
  lista          String
  mensagem       String
  templateId     String?
  scheduledAt    DateTime?
  intervaloMin   Int
  intervaloMax   Int
  intervaloFaixa String?
  status         String
  total          Int
  enviadas       Int       @default(0)
  respostas      Int       @default(0)
  pausedAt       DateTime?
  nextSendAt     DateTime? // motor de disparos: não enviar antes deste instante
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([workspaceId])
}

// Fila de envio de uma campanha. O worker de disparos (próxima etapa) consome os "pendente".
model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  contactId  String
  status     String    @default("pendente")
  sentAt     DateTime?
  error      String?
  repliedAt  DateTime? // cliente respondeu ao disparo (contado em Campaign.respostas)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

model FollowUpRule {
  id             String   @id @default(cuid())
  workspaceId    String   @unique
  enabled        Boolean  @default(false)
  esperaHoras    Int      @default(6)
  tentativas     Int      @default(2)
  mensagens      String[]
  stopConditions String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model FollowUpJob {
  id             String   @id @default(cuid())
  conversationId String
  tentativa      Int
  runAt          DateTime
  status         String // pendente | executando | enviado | erro | cancelado
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([conversationId, status])
}

model CalendarConnection {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  provider          String    @default("google")
  email             String
  tokens            String? // criptografado
  calendarios       Json?
  destinoId         String?
  iaPodeAgendar     Boolean   @default(false)
  duracaoPadraoMin  Int       @default(60)
  lembretes         String[]
  // Sincronização com o Google: syncToken por agenda ({ [calendarId]: token }), última leitura
  // bem-sucedida (exibida na tela), última tentativa do agendador e sinal de acesso revogado.
  syncTokens        Json?
  ultimaSyncEm      DateTime?
  syncTentadaEm     DateTime?
  precisaReconectar Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // O lembrete pede "1 para confirmar, 2 para remarcar" (migration 0012).
  pedirConfirmacao  Boolean   @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Nonce de uso único do state do OAuth do Google (validade de 10 min).
model CalendarOAuthState {
  id          String   @id
  workspaceId String
  expiraEm    DateTime
  createdAt   DateTime @default(now())

  @@index([expiraEm])
}

model Event {
  id               String      @id @default(cuid())
  workspaceId      String
  contactId        String?
  inicio           DateTime
  duracaoMin       Int
  titulo           String
  tipo             String
  origem           EventOrigin
  googleEventId    String?
  // Agenda do Google onde o evento foi criado (pode diferir do destino atual).
  googleCalendarId String?
  // Tipo de atendimento escolhido (o texto `tipo` guarda o nome na hora do agendamento).
  serviceTypeId    String?
  // De onde veio o agendamento além da origem: 'link' = página pública de agendamento.
  canal            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  // ---- IA agendando e confirmação de presença (migration 0012) ----
  // ativo | cancelado (cancelado some da grade e libera o horário, mas fica no banco para o painel de resultados).
  status           String      @default("ativo")
  canceladoEm      DateTime?
  // cliente (pediu pelo WhatsApp) | equipe
  canceladoPor     String?
  // pendente | confirmado | recusado (pediu para remarcar)
  confirmacao      String      @default("pendente")
  confirmadoEm     DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  serviceType ServiceType?    @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  reminders   EventReminder[]

  @@index([workspaceId, inicio])
  @@index([contactId, inicio])
}

// Tipos de atendimento/serviços do negócio (aparecem ao agendar, nos lembretes e no prompt da IA).
model ServiceType {
  id          String   @id @default(cuid())
  workspaceId String
  nome        String
  duracaoMin  Int
  cor         String?
  ordem       Int
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    Event[]

  @@unique([workspaceId, nome])
  @@index([workspaceId, ativo, ordem])
}

model Invoice {
  id          String   @id @default(cuid())
  workspaceId String
  valor       Decimal
  status      String
  pdfUrl      String?
  emitidaEm   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model UsageCounter {
  id                   String   @id @default(cuid())
  workspaceId          String
  mes                  String // YYYY-MM
  mensagensAtendimento Int      @default(0)
  respostasIa          Int      @default(0)
  disparos             Int      @default(0)
  // Segundos de áudio transcritos no mês.
  transcricoesSeg      Int      @default(0)
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, mes])
}

// Resposta da IA agendada (debounce de 4 s). O agendador do motor consome os "pendente".
model AiJob {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String
  status         String // pendente | executando | feito | erro
  runAt          DateTime
  attempts       Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())
  // Chamadas de ferramenta da execução: [{ nome, ok, erro? }] (sem dados pessoais). Migration 0012.
  ferramentas    Json?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([conversationId, status])
}

// Lembrete de agenda já enviado (uma vez por evento e tipo).
model EventReminder {
  id      String   @id @default(cuid())
  eventId String
  kind    String // 24h | 2h | 30min
  sentAt  DateTime @default(now())
  result  String? // enviado | pulado:<motivo>
  // O texto do lembrete pediu "1 para confirmar, 2 para remarcar" (migration 0012).
  pediuConfirmacao Boolean @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
}

// Agendamento feito pela página pública: base do limite de abuso (IP e telefone só em hash HMAC).
model BookingAttempt {
  id           String   @id @default(cuid())
  workspaceId  String
  ipHash       String
  telefoneHash String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ipHash, createdAt])
  @@index([workspaceId, telefoneHash, createdAt])
  @@index([createdAt])
}

// ---- Segurança do login (migração 0011) ----

// Tentativas de login/redefinição, só com HMAC do e-mail e do IP (nunca o valor). Base dos limites; sobrevive a reinício.
model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  sucesso   Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// Códigos de recuperação do 2FA: só o HMAC fica guardado; uso único (usedAt).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

// ---- Respostas rápidas (migração 0013) ----

// Atalhos de texto do composer ("/pix"). Por espaço (cada WhatsApp tem as suas).
model QuickReply {
  id          String   @id @default(cuid())
  workspaceId String
  atalho      String
  titulo      String?
  texto       String
  ordem       Int      @default(0)
  usos        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, atalho])
  @@index([workspaceId, ordem])
}

// ---- Meta oficial (migration 0014) ----

/// Nonce de uso único do cadastro incorporado: liga o retorno da Meta à sessão (usuário) e ao workspace que o iniciou.
model MetaSignupState {
  id          String    @id
  workspaceId String
  userId      String
  mode        String // sdk | hosted
  expiraEm    DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiraEm])
  @@index([workspaceId])
}

/// Cadastro concluído no fluxo hospedado pela Meta (webhook account_update PARTNER_ADDED), esperando o workspace reivindicar.
model MetaPartnerEvent {
  id                 String    @id @default(cuid())
  wabaId             String
  businessId         String?
  event              String
  claimedByWorkspace String?
  claimedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([wabaId])
  @@index([createdAt])
}

// Equipe (migração 0015): espaços (WhatsApps) a que um atendente tem acesso. Owner/admin enxergam todos da organização.
model SpaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Convite para a equipe. O token (32 bytes aleatórios) NUNCA é guardado: só o hash.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  papel          String
  workspaceIds   String[]  @default([])
  tokenHash      String    @unique
  convidadoPorId String?
  expiraEm       DateTime
  aceitoEm       DateTime?
  revogadoEm     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  convidadoPor User?        @relation(fields: [convidadoPorId], references: [id], onDelete: SetNull)

  @@index([organizationId, aceitoEm, revogadoEm])
  @@index([email])
}

// Auditoria mínima (migração 0015). Nunca guarda conteúdo de mensagens nem dados de contatos.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  userId         String?
  acao           String
  alvo           String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ---- Caixa de entrada dos webhooks (migration 0021, robustez do caminho da mensagem) ----
// Todo evento de mensagem/status/conexão da Evolution e da Meta é gravado AQUI antes da resposta 2xx e processado a
// partir daqui: queda/deploy entre o 200 e o processamento não perde nada (o agendador drena o pendente). O corpo é
// guardado cifrado (AES-256-GCM, ENCRYPTION_KEY) e apagado alguns dias depois de processado. Nunca vai para log.
model WebhookInbox {
  id            String    @id @default(cuid())
  provider      String // evolution | meta
  dedupeKey     String // sha256 do corpo cru: reentrega idêntica do provedor não duplica
  payload       String // corpo cru cifrado
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  // Desistiu depois de MAX tentativas (fica guardado para diagnóstico/reprocesso manual).
  deadAt        DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  lastError     String?

  @@unique([provider, dedupeKey])
  @@index([processedAt, nextAttemptAt])
  @@index([receivedAt])
}

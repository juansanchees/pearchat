# Conexão com o Postgres (docker compose)
DATABASE_URL="postgresql://pearchat:pearchat@localhost:5432/pearchat?schema=public"
# Conexão com o Redis (filas BullMQ)
REDIS_URL="redis://localhost:6379"
# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET=""
# URL pública do app usada pelo Auth.js
AUTH_URL="http://localhost:3000"
# URL pública do app usada no front e em callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# ID do app na Meta (API Oficial do WhatsApp)
META_APP_ID=""
# Segredo do app na Meta
META_APP_SECRET=""
# ID de configuração do Embedded Signup (Coexistence)
META_CONFIG_ID=""
# Token de verificação do webhook da Meta (string livre que você define)
META_VERIFY_TOKEN=""
# Token de usuário do sistema da Meta (do SEU Business Manager). Só é necessário no cadastro hospedado pela Meta
# (META_SIGNUP_MODE=hosted) e como último recurso para a WABA de teste do próprio dono.
META_SYSTEM_USER_TOKEN=""
# Versão da Graph API (padrão v25.0, a mesma mostrada no painel do app)
META_GRAPH_VERSION="v25.0"
# Como conectar a API oficial: "sdk" (popup do Facebook, padrão; cai sozinho para o link hospedado se o SDK não carregar)
# ou "hosted" (link hospedado pela Meta, resultado via webhook account_update)
META_SIGNUP_MODE="sdk"
# Beta fechado da conexão oficial: com "false", só os e-mails abaixo (separados por vírgula) veem a opção; os demais
# continuam vendo "Em breve". Mude para "true" depois da aprovação da Análise do App.
META_OFICIAL_BETA="false"
META_OFICIAL_BETA_EMAILS=""
# Opcional: tipo de fluxo do FB.login (ex.: whatsapp_business_app_onboarding para forçar a Coexistence) e versão das
# informações de sessão (padrão 3). Deixe vazio para o popup da Meta decidir.
META_FEATURE_TYPE=""
META_SESSION_INFO_VERSION="3"
# SÓ PARA TESTE: outra base para a Graph API (servidor falso). Nunca definir em produção.
# META_GRAPH_BASE_URL="http://127.0.0.1:3036"
# URL da Evolution API (conexão rápida)
EVOLUTION_API_URL="http://localhost:8080"
# Chave global de autenticação da Evolution API
EVOLUTION_API_KEY=""
# URL que a Evolution chama para entregar webhooks (use host.docker.internal quando o app roda fora do Docker)
EVOLUTION_WEBHOOK_URL="http://host.docker.internal:3000/api/wa/evolution"
# Chave da OpenAI para o agente de IA (opcional por enquanto)
OPENAI_API_KEY=""
# Alternativa: chave da Anthropic para o agente de IA (opcional por enquanto)
ANTHROPIC_API_KEY=""
# Modelo usado pelo agente de IA (padrão: claude-haiku-4-5-20251001 na Anthropic, gpt-4o-mini na OpenAI)
AI_MODEL=""
# Chave de 32 bytes em base64 para criptografar sessões e tokens (openssl rand -base64 32)
ENCRYPTION_KEY=""
# Pasta das mídias das conversas (imagens, áudios, documentos). Dev: ./.media; produção: /data/media (volume pearchat_media)
MEDIA_DIR=""
# Modelo de transcrição de áudio (OpenAI /v1/audio/transcriptions). Padrão gpt-4o-mini-transcribe; "off" desliga.
# O projeto da OpenAI da chave precisa ter acesso ao modelo (senão a transcrição fica inativa, sem derrubar nada).
AI_TRANSCRIBE_MODEL=""
# A IA enxerga a imagem da última mensagem do cliente: auto (padrão) | off
AI_VISION=""

# Liga o provedor de mentira do WhatsApp (navega o app sem Evolution/Meta)
WA_MOCK=true
# Espelho público do WA_MOCK: a tela segue o fluxo simulado do protótipo
NEXT_PUBLIC_WA_MOCK=true
# ID do app na Meta usado pelo SDK do Facebook no navegador (Embedded Signup)
NEXT_PUBLIC_META_APP_ID=
# ID de configuração do Embedded Signup usado no FB.login (config_id)
NEXT_PUBLIC_META_CONFIG_ID=

# ID do cliente OAuth do Google (Google Agenda)
GOOGLE_CLIENT_ID=
# Segredo do cliente OAuth do Google
GOOGLE_CLIENT_SECRET=
# Login com Google ("Continuar com Google"): usa este mesmo cliente (escopos openid email profile). Cadastre no Google Cloud as URIs de retorno:
#   http://localhost:3000/api/auth/callback/google  e  https://pearchat.online/api/auth/callback/google
# Alternativa: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET. Sem credenciais o botão fica como "Em breve".
# URI de redirecionamento OAuth (vazio = APP_URL/api/calendar/google/callback)
GOOGLE_REDIRECT_URI=
# Google Agenda: escopos calendar.events e calendar.readonly. Em desenvolvimento use
# http://localhost:3000/api/calendar/google/callback; em produção https://pearchat.online/api/calendar/google/callback
# (a mesma URI precisa estar em "URIs de redirecionamento autorizados" do cliente OAuth).
# Sem GOOGLE_CLIENT_ID/SECRET a tela usa o fluxo simulado (demonstração).

# Motor de automações (agendador em processo: IA, disparos, follow-up, lembretes)
# true = não inicia o agendador (útil para rodar só a interface)
ENGINE_DISABLED=
# Conexão rápida: máximo de disparos por dia por workspace (padrão 200)
CAMPAIGN_DAILY_LIMIT=200
# Só com WA_MOCK=true: ignora a janela de silêncio (21h às 8h) do follow-up, para testes
ENGINE_FOLLOWUP_ANYTIME=

# E-mail transacional via Resend (redefinicao de senha, codigo de verificacao, boas-vindas).
# Sem RESEND_API_KEY e MAIL_FROM o e-mail nao e enviado e o cadastro segue direto ao onboarding (sem verificacao).
# MAIL_FROM no formato: PearChat <nao-responda@pearchat.online> (dominio verificado no Resend)
RESEND_API_KEY=
MAIL_FROM=
# Data ISO (ex.: 2026-10-05T00:00:00Z): contas criadas a partir dela sao obrigadas a verificar o e-mail
# (so vale com e-mail configurado). Vazio = nunca forca contas sem codigo pendente. Contas antigas nao sao trancadas.
# Vale tambem no SERVIDOR: sem e-mail confirmado, as rotas que enviam mensagens, gastam IA (Testar o agente), convidam pessoas ou conectam
# o WhatsApp respondem 403 EMAIL_NAO_VERIFICADO. Ao ligar o e-mail em producao, defina a data de hoje aqui (contas antigas seguem livres).
EMAIL_VERIFICATION_SINCE=
# SOMENTE teste/desenvolvimento: true = nunca chama o Resend, em nenhum modo, e registra o texto do e-mail (com o codigo) no log do servidor. NAO defina em producao.
MAIL_DRY_RUN=

# Conta de DEMONSTRACAO do seed (SOMENTE desenvolvimento, nunca em producao). Sem valor padrao: sem esta senha (12+ caracteres) o seed nao cria a conta.
# O seed recusa NODE_ENV=production e banco que nao seja local, a menos que SEED_ALLOW_PRODUCTION=1 / SEED_ALLOW_REMOTE=1 (de proposito).
# Para trocar a senha de uma conta existente: ROTATE_PASSWORD='...' npx tsx scripts/rotate-demo-password.ts <email>
SEED_DEMO_PASSWORD=

# Pagamentos e limites de plano (Asaas). Guia completo em docs/pagamentos.md.
# false (padrao) = sem cobranca, sem teste gratis, sem restricao: o app funciona como sempre.
BILLING_ENABLED=false
# Sandbox: https://api-sandbox.asaas.com | Producao: https://api.asaas.com
ASAAS_BASE_URL=https://api-sandbox.asaas.com
# Chave de API da conta Asaas (Integracoes > Chaves de API). Nunca commitar.
ASAAS_API_KEY=
# Token do webhook: invente um valor longo e cadastre o MESMO no Asaas (cabecalho asaas-access-token). deploy/gen-env.mjs gera um.
ASAAS_WEBHOOK_TOKEN=
# Dias de teste gratis das contas NOVAS (plano Essencial) e dias de carencia de uma fatura atrasada antes do modo restrito
TRIAL_DAYS=7
BILLING_GRACE_DAYS=5
# Precos mensais em reais (vazio = 79 / 149 / 299, os valores mostrados no app)
PLAN_PRICE_ESSENCIAL=
PLAN_PRICE_PRO=
PLAN_PRICE_NEGOCIOS=
# SOMENTE desenvolvimento: true = provedor falso em memoria (sem chamar o Asaas). Ignorado em producao.
BILLING_MOCK=

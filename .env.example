# Conexão com o Postgres (docker compose)
DATABASE_URL="postgresql://pearchat:pearchat@localhost:5432/pearchat?schema=public"
# Conexão com o Redis (filas BullMQ)
REDIS_URL="redis://localhost:6379"
# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET=""
# URL pública do app usada pelo Auth.js
AUTH_URL="http://localhost:3000"
# URL pública do app usada no front e em callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# ID do app na Meta (API Oficial do WhatsApp)
META_APP_ID=""
# Segredo do app na Meta
META_APP_SECRET=""
# ID de configuração do Embedded Signup (Coexistence)
META_CONFIG_ID=""
# Token de verificação do webhook da Meta (string livre que você define)
META_VERIFY_TOKEN=""
# Token de usuário do sistema da Meta para chamadas à Graph API
META_SYSTEM_USER_TOKEN=""
# URL da Evolution API (conexão rápida)
EVOLUTION_API_URL="http://localhost:8080"
# Chave global de autenticação da Evolution API
EVOLUTION_API_KEY=""
# URL que a Evolution chama para entregar webhooks (use host.docker.internal quando o app roda fora do Docker)
EVOLUTION_WEBHOOK_URL="http://host.docker.internal:3000/api/wa/evolution"
# Chave da OpenAI para o agente de IA (opcional por enquanto)
OPENAI_API_KEY=""
# Alternativa: chave da Anthropic para o agente de IA (opcional por enquanto)
ANTHROPIC_API_KEY=""
# Modelo usado pelo agente de IA (padrão: claude-haiku-4-5-20251001 na Anthropic, gpt-4o-mini na OpenAI)
AI_MODEL=""
# Chave de 32 bytes em base64 para criptografar sessões e tokens (openssl rand -base64 32)
ENCRYPTION_KEY=""

# Liga o provedor de mentira do WhatsApp (navega o app sem Evolution/Meta)
WA_MOCK=true
# Espelho público do WA_MOCK: a tela segue o fluxo simulado do protótipo
NEXT_PUBLIC_WA_MOCK=true
# ID do app na Meta usado pelo SDK do Facebook no navegador (Embedded Signup)
NEXT_PUBLIC_META_APP_ID=
# ID de configuração do Embedded Signup usado no FB.login (config_id)
NEXT_PUBLIC_META_CONFIG_ID=

# ID do cliente OAuth do Google (Google Agenda)
GOOGLE_CLIENT_ID=
# Segredo do cliente OAuth do Google
GOOGLE_CLIENT_SECRET=
# Login com Google ("Continuar com Google"): usa este mesmo cliente (escopos openid email profile). Cadastre no Google Cloud as URIs de retorno:
#   http://localhost:3000/api/auth/callback/google  e  https://pearchat.online/api/auth/callback/google
# Alternativa: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET. Sem credenciais o botão fica como "Em breve".
# URI de redirecionamento OAuth (vazio = APP_URL/api/calendar/google/callback)
GOOGLE_REDIRECT_URI=
# Google Agenda: escopos calendar.events e calendar.readonly. Em desenvolvimento use
# http://localhost:3000/api/calendar/google/callback; em produção https://pearchat.online/api/calendar/google/callback
# (a mesma URI precisa estar em "URIs de redirecionamento autorizados" do cliente OAuth).
# Sem GOOGLE_CLIENT_ID/SECRET a tela usa o fluxo simulado (demonstração).

# Motor de automações (agendador em processo: IA, disparos, follow-up, lembretes)
# true = não inicia o agendador (útil para rodar só a interface)
ENGINE_DISABLED=
# Conexão rápida: máximo de disparos por dia por workspace (padrão 200)
CAMPAIGN_DAILY_LIMIT=200
# Só com WA_MOCK=true: ignora a janela de silêncio (21h às 8h) do follow-up, para testes
ENGINE_FOLLOWUP_ANYTIME=

# E-mail transacional (redefinicao de senha) via Resend. Sem estas duas, o e-mail nao e enviado (so log no servidor)
RESEND_API_KEY=
MAIL_FROM=

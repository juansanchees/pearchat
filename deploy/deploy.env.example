# Modelo da configuracao LOCAL de publicacao. Copie para deploy/.deploy.env (esse arquivo e ignorado pelo git) e preencha.
# Nada aqui deve ir para o repositorio: endereco do servidor, usuario e caminho da chave sao dados de quem opera.
PEARCHAT_HOST=            # endereco (IP ou nome) da VPS
PEARCHAT_USER=root        # usuario do SSH
PEARCHAT_KEY=             # caminho da chave privada SSH, ex.: /c/Users/voce/.ssh/pearchat_vps
PEARCHAT_DOMAIN=pearchat.online
